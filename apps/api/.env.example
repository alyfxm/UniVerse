# =============================================================================
# UniVerse Environment Configuration Example
# Copy this file to .env and fill in your credentials
# =============================================================================

# Application Environment: development | test | production
APP_ENV=development
APP_NAME=UniVerse API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Storage & ChromaDB Configuration
CHROMA_PERSIST_DIR=../../data/chroma
CHROMA_COLLECTION_NAME=universe_knowledge_v1
UPLOAD_DIR=../../data/uploads
MAX_UPLOAD_SIZE_MB=25

# Local / Fallback Mode (Enables deterministic local testing when external keys are not set)
USE_LOCAL_STORAGE_FALLBACK=true

